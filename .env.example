# Copy to .env and fill in. In production (Coolify) these variables are loaded
# one by one in the UI, not from this file -- see README.md.

# Keys the gateway accepts from clients (X-API-Key header, or
# `Authorization: Bearer`), comma-separated
LLM_LIBRE_API_KEYS=putone,andtwo

# chatgpt-proxy: an IN-HOUSE service exposing ChatGPT through its anonymous
# flow, deployed on `blog`. No credentials -- just the URL. NOTE: it includes
# the /v1 (the proxy's real paths are /v1/chat/completions and /v1/models, e.g.
# https://chatgpt.blog.example/v1). If missing, it falls back to the default in
# providers.yaml (http://127.0.0.1:8888/v1), which is useless in production:
# set it once the proxy is deployed.
CHATGPT_PROXY_URL=

# Free provider. KILO_API_KEY is left UNDEFINED (not blank) in a real
# environment: Kilo's anonymous tier depends on no Authorization header
# travelling at all. It is documented here, empty, only as a reminder that the
# variable exists and is optional.
KILO_API_KEY=

# openrouter (same pattern as kilo: discovered catalogue, key optional in the
# code even though its free tier does demand one in practice) has been REMOVED
# from the registry (providers.yaml) since 2026-08-17: it never had
# OPENROUTER_API_KEY configured in production, so its 16 routes 401'd every time
# and only took up probe budget and space in /v1/ranking proving they were dead.
# Adding it back is a YAML entry plus this variable, not a code change -- see
# docs/providers.md.

# mistral-proxy: an IN-HOUSE service exposing Le Chat through the protocol
# reverse-engineered from the Mistral Android app. Needs no key here -- it holds
# its own MISTRAL_SESSION_TOKEN -- only the URL, which includes the /v1. If
# missing, it falls back to the default in providers.yaml
# (http://127.0.0.1:8894/v1), which is useless in production: set it once the
# proxy is deployed.
MISTRAL_PROXY_URL=

# Paid provider (the automatic fallback tier)
MINIMAX_API_KEY=

# Where the SQLite database lives. The production default is
# /datos/llm-libre.sqlite3, on a volume that deliberately survives redeploys.
DB_PATH=/datos/llm-libre.sqlite3

# Which provider registry to read
PROVIDERS_YAML=providers.yaml

# Probing cadences
HEALTH_PROBE_HOURS=5
QUALITY_PROBE_EVERY_N_CYCLES=5

# Daily paid-fallback cap, in requests per key
DAILY_PAID_CAP=200

# Requests per minute, per key
PER_MINUTE_LIMIT=60

# Draw between tied routes. On by default -- with the quality battery scoring
# the whole catalogue at 1.00, a strict order always sends traffic to the same
# route and burns one provider's quota while the others watch. Set to false for
# a strictly deterministic order, useful when debugging an odd response.
ROTATE_TIES=true

# --- Renamed on 2026-08-18 -------------------------------------------------
# These variables used to be Spanish. The code still reads the OLD names as a
# fallback (the new one wins), so a deployment configured with them keeps
# working until it is updated. Once Coolify is updated, the fallback in
# main._env can go.
#
#   PROVEEDORES_YAML             -> PROVIDERS_YAML
#   RUTA_DB                      -> DB_PATH
#   SONDEO_SALUD_HORAS           -> HEALTH_PROBE_HOURS
#   SONDEO_CALIDAD_CADA_N_CICLOS -> QUALITY_PROBE_EVERY_N_CYCLES
#   ROTAR_EMPATES                -> ROTATE_TIES
#   TOPE_PAGO_DIARIO             -> DAILY_PAID_CAP
#   LIMITE_POR_MINUTO            -> PER_MINUTE_LIMIT
