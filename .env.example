# Copiar a .env y completar. En produccion (Coolify) estas variables se
# cargan una por una en la UI, no desde este archivo -- ver README.md.

# Llaves que aceptan los clientes (cabecera X-API-Key), separadas por coma
LLM_LIBRE_API_KEYS=poneuna,ydos

# Proveedores gratis. KILO_API_KEY se deja SIN DEFINIR (no en blanco) en un
# entorno real: el tier anonimo de Kilo depende de que no viaje ninguna
# cabecera Authorization. Se documenta aca vacia solo como referencia de que
# la variable existe y es opcional.
KILO_API_KEY=
OPENROUTER_API_KEY=

# Proveedor de pago (escalon de fallback automatico)
MINIMAX_API_KEY=

# Cadencias de sondeo
SONDEO_SALUD_HORAS=5
SONDEO_CALIDAD_CADA_N_CICLOS=5

# Tope diario de fallback pago, en peticiones por llave
TOPE_PAGO_DIARIO=200

# Limite de peticiones por minuto, por llave
LIMITE_POR_MINUTO=60
